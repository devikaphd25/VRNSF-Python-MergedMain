<style>
  .side-controls { width: 720; height: 790; flex-direction: column; align-items: center; justify-content: flex-start; padding-top: 34; gap: 18; background-opacity: 0; }
  .student-control-row { width: 650; height: 100; flex-direction: row; align-items: center; justify-content: center; gap: 16; background-opacity: 0; }
  .control-title { font-family: inter; font-size: 34; font-weight: 600; color: #cbd5e1; text-align: center; }
  .hand-control { width: 100; height: 100; flex-shrink: 0; background-opacity: 0; border-width: 0; cursor: pointer; pointer-events: auto; }
  .hand-label { width: 190; font-family: inter; font-size: 30; font-weight: 600; color: #e0f2fe; text-align: center; pointer-events: none; }
  .student-name { width: 310; font-family: inter; font-size: 30; font-weight: 600; color: #ffffff; text-align: center; pointer-events: none; }
</style>
<Panel class="side-controls">
  <Text class="control-title">Control Panel</Text>
  <Panel class="student-control-row">
    <Button id="side-raise-hand" class="hand-control"></Button>
    <Text id="side-hand-label" class="hand-label">Raise Hand</Text>
    <Text id="side-student-name" class="student-name">Student</Text>
  </Panel>
</Panel>
