        </Panel>

        <Text id="quiz-instruction" class="quiz-instruction answer-hidden">Select one answer</Text>
        <Image id="quiz-explain-face" class="quiz-explain-face answer-hidden" src="/textures/quiz/icons/check.png" />
        <Text id="quiz-explanation" class="quiz-explanation answer-hidden"></Text>
        <Text id="quiz-feedback" class="quiz-feedback answer-hidden"></Text>

        <Panel id="quiz-result-card" class="quiz-result-card quiz-result-hidden">
