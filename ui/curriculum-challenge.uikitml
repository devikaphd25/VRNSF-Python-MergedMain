        <Panel id="quiz-answer-row-3" class="answer-row answer-hidden">
          <Button id="quiz-answer-4" class="answer-button answer-button-wide">
            <Image id="quiz-answer-face-4" class="answer-face answer-face-wide answer-hidden" src="/textures/playtest_student/LightUIButton.png" />
