            <Button id="quiz-review-q-0" class="quiz-review-q"><Image id="quiz-review-glyph-0" class="quiz-review-glyph" src="/textures/quiz/icons/check.png" /></Button>
            <Button id="quiz-review-q-1" class="quiz-review-q"><Image id="quiz-review-glyph-1" class="quiz-review-glyph" src="/textures/quiz/icons/check.png" /></Button>
            <Button id="quiz-review-q-2" class="quiz-review-q"><Image id="quiz-review-glyph-2" class="quiz-review-glyph" src="/textures/quiz/icons/check.png" /></Button>
            <Button id="quiz-review-q-3" class="quiz-review-q"><Image id="quiz-review-glyph-3" class="quiz-review-glyph" src="/textures/quiz/icons/check.png" /></Button>
            <Button id="quiz-review-q-4" class="quiz-review-q"><Image id="quiz-review-glyph-4" class="quiz-review-glyph" src="/textures/quiz/icons/check.png" /></Button>
            <Button id="quiz-review-q-5" class="quiz-review-q answer-hidden"><Image id="quiz-review-glyph-5" class="quiz-review-glyph" src="/textures/quiz/icons/check.png" /></Button>
            <Button id="quiz-review-q-6" class="quiz-review-q answer-hidden"><Image id="quiz-review-glyph-6" class="quiz-review-glyph" src="/textures/quiz/icons/check.png" /></Button>
          </Panel>
          <Panel id="quiz-review-extra" class="quiz-review-row answer-hidden">
            <Button id="quiz-review-extra-0" class="quiz-review-q"><Image id="quiz-review-extra-glyph-0" class="quiz-review-glyph" src="/textures/quiz/icons/check.png" /></Button>
            <Button id="quiz-review-extra-1" class="quiz-review-q"><Image id="quiz-review-extra-glyph-1" class="quiz-review-glyph" src="/textures/quiz/icons/check.png" /></Button>
            <Button id="quiz-review-extra-2" class="quiz-review-q"><Image id="quiz-review-extra-glyph-2" class="quiz-review-glyph" src="/textures/quiz/icons/check.png" /></Button>
          </Panel>
          </Panel>
          <Text id="quiz-result-hint" class="quiz-result-hint answer-hidden">tap to review</Text>
          <Text id="quiz-result-time" class="quiz-result-time">Time taken: 0.0 seconds</Text>
          <Text id="quiz-result-winner" class="quiz-result-winner"></Text>
        </Panel>
        </Panel>

        <Panel class="quiz-footer">
        <Panel id="quiz-toolbar" class="quiz-toolbar">
          <Button id="quiz-prev" class="nav-button answer-hidden">
            <Image id="quiz-prev-face" class="nav-face" src="/textures/playtest_student/Previous.png" />
          </Button>
          <Button id="quiz-submit" class="submit-button">
            <Image id="quiz-submit-face" class="submit-face" src="/textures/playtest_student/Submit_Button.png" />
            <Text id="quiz-submit-label" class="quiz-instruction">SUBMIT ONLY IF ALL ANSWERED.</Text>
          </Button>
          <Button id="quiz-next" class="nav-button answer-hidden">
            <Image id="quiz-next-face" class="nav-face" src="/textures/playtest_student/Next.png" />
          </Button>
        </Panel>
        <Panel id="quiz-result-actions" class="quiz-result-actions answer-hidden">
          <Button id="quiz-result-reset" class="quiz-result-reset quiz-result-hidden">
            <Image id="quiz-reset-face" class="action-face" src="/textures/playtest_student/LightUIButton.png" />
          </Button>
          <Button id="quiz-result-close" class="quiz-result-close quiz-result-hidden">
            <Image id="quiz-close-face" class="action-face" src="/textures/playtest_student/DarkUIButton.png" />
          </Button>
        </Panel>
        </Panel>
      </Panel>
    </Panel>
    <Image id="quiz-title-banner" class="quiz-title-banner" src="/textures/playtest_student/Title_for_assignment.png" />
