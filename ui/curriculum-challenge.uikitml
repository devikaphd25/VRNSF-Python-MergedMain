      <Panel id="code-board-content" class="quiz-board-content">
        <Image id="code-face" class="quiz-board-art" src="/textures/playtest_student/UI_Background.png" />
      </Panel>
    </Panel>
  </Panel>
  <Panel class="quiz-column">
    <Panel class="quiz-title-slot"></Panel>
    <Text id="quiz-title" class="quiz-title">Challenge</Text>
    <Text id="quiz-kicker" class="quiz-kicker">Student Challenge</Text>
    <Text id="quiz-progress" class="quiz-progress"></Text>

    <Panel class="quiz-board">
      <Image class="quiz-board-art" src="/textures/playtest_student/UI_Background.png" />
      <Panel class="quiz-board-content">
        <Panel id="quiz-main" class="quiz-main">
        <Panel id="quiz-header" class="quiz-header">
          <Panel id="quiz-steps" class="quiz-steps answer-hidden">
            <Image id="quiz-steps-rail" class="quiz-steps-rail" src="/textures/quiz/icons/check.png" />
            <Panel class="quiz-step-hits">
              <Button id="quiz-step-0" class="quiz-step-hit"></Button>
              <Button id="quiz-step-1" class="quiz-step-hit"></Button>
              <Button id="quiz-step-2" class="quiz-step-hit"></Button>
              <Button id="quiz-step-3" class="quiz-step-hit"></Button>
              <Button id="quiz-step-4" class="quiz-step-hit"></Button>
              <Button id="quiz-step-5" class="quiz-step-hit answer-hidden"></Button>
              <Button id="quiz-step-6" class="quiz-step-hit answer-hidden"></Button>
            </Panel>
          </Panel>
        </Panel>

        <Image id="quiz-question-face" class="quiz-question-face answer-hidden" src="/textures/quiz/icons/check.png" />
        <Text id="quiz-question" class="quiz-question">
          Loading question from the classroom server…
        </Text>

        <Panel id="quiz-answer-row-1" class="answer-row">
          <Button id="quiz-answer-0" class="answer-button">
            <Image id="quiz-answer-face-0" class="answer-face answer-hidden" src="/textures/playtest_student/LightUIButton.png" />
            <Image id="quiz-answer-icon-0" class="answer-icon answer-hidden" src="/textures/quiz/icons/check.png" />
            <Text id="quiz-answer-label-0" class="answer-label"></Text>
          </Button>
          <Button id="quiz-answer-1" class="answer-button">
            <Image id="quiz-answer-face-1" class="answer-face answer-hidden" src="/textures/playtest_student/LightUIButton.png" />
            <Image id="quiz-answer-icon-1" class="answer-icon answer-hidden" src="/textures/quiz/icons/cross.png" />
            <Text id="quiz-answer-label-1" class="answer-label"></Text>
          </Button>
        </Panel>

        <Image id="quiz-dnd-face" class="quiz-dnd-face answer-hidden" src="/textures/playtest_student/LightUIButton.png" />

        <Panel id="quiz-answer-row-2" class="answer-row">
          <Button id="quiz-answer-2" class="answer-button">
            <Image id="quiz-answer-face-2" class="answer-face answer-hidden" src="/textures/playtest_student/LightUIButton.png" />
