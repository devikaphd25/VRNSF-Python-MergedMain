          <Button id="quiz-answer-3" class="answer-button">
            <Image id="quiz-answer-face-3" class="answer-face answer-hidden" src="/textures/playtest_student/LightUIButton.png" />
            <Image id="quiz-answer-icon-3" class="answer-icon answer-hidden" src="/textures/quiz/icons/cross.png" />
            <Text id="quiz-answer-label-3" class="answer-label"></Text>
          </Button>
