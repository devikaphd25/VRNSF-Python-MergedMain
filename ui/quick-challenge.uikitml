<style>
  .quiz-root {
    width: 92;
    padding: 5;
    flex-direction: column;
    gap: 2.4;
    background-color: rgba(4, 16, 38, 0.98);
    border-width: 0.25;
    border-color: rgba(96, 165, 250, 0.75);
    border-radius: 4;
    pointer-events: auto;
    pointer-events-order: 15000;
  }

  .quiz-header {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 2;
    border-bottom-width: 0.15;
    border-bottom-color: rgba(139, 92, 246, 0.7);
  }

  .quiz-title {
    color: white;
    font-size: 4.2;
    font-weight: bold;
  }

  .quiz-progress {
    color: #a5b4fc;
    font-size: 2.2;
    font-weight: bold;
  }

  .quiz-timer {
    padding-left: 2.2;
    padding-right: 2.2;
    padding-top: 1.1;
    padding-bottom: 1.1;
    color: white;
    font-size: 2.4;
    font-weight: bold;
    background-color: rgba(76, 29, 149, 0.45);
    border-width: 0.18;
    border-color: #a78bfa;
    border-radius: 2.2;
  }

  .quiz-question {
    width: 100%;
    color: white;
    font-size: 3.1;
    font-weight: bold;
    text-align: center;
    padding-top: 1.4;
    padding-bottom: 1.4;
  }

  .answer-row {
    width: 100%;
    flex-direction: row;
    gap: 2;
  }

  .answer-button {
    width: 50%;
    height: 11;
    padding-left: 2.5;
    padding-right: 2.5;
    align-items: center;
    justify-content: flex-start;
    color: white;
    font-size: 2.6;
    font-weight: bold;
    background-color: rgba(51, 65, 85, 0.88);
    border-width: 0.2;
    border-color: rgba(148, 163, 184, 0.45);
    border-radius: 2.2;
    cursor: pointer;
    pointer-events: auto;
    pointer-events-order: 15001;
  }

  .answer-selected {
    color: #ecfeff;
    background-color: rgba(8, 145, 178, 0.42);
    border-width: 0.38;
    border-color: #22d3ee;
  }

  .answer-hidden { display: none; }

  .quiz-instruction {
    width: 100%;
    color: #c4b5fd;
    font-size: 2;
    text-align: center;
  }

  .quiz-actions {
    width: 100%;
    flex-direction: row;
    gap: 2;
  }

  .submit-button {
    width: 65%;
    height: 8.5;
    align-items: center;
    justify-content: center;
    color: #06202b;
    font-size: 2.7;
    font-weight: bold;
    background-color: #22d3ee;
    border-radius: 2.2;
    cursor: pointer;
    pointer-events: auto;
    pointer-events-order: 15001;
  }

  .clear-button {
    width: 35%;
    height: 8.5;
    align-items: center;
    justify-content: center;
    color: #cbd5e1;
    font-size: 2.1;
    font-weight: bold;
    background-color: rgba(15, 23, 42, 0.9);
    border-width: 0.2;
    border-color: #64748b;
    border-radius: 2.2;
    cursor: pointer;
    pointer-events: auto;
    pointer-events-order: 15001;
  }

  .quiz-feedback {
    width: 100%;
    color: #a5b4fc;
    font-size: 2.2;
    font-weight: bold;
    text-align: center;
  }

  .feedback-correct {
    color: #6ee7b7;
  }

  .feedback-incorrect {
    color: #fca5a5;
  }
</style>

<Panel class="quiz-root">
  <Panel class="quiz-header">
    <Panel>
      <Text class="quiz-title">QUICK CHALLENGE</Text>
      <Text class="quiz-progress">Question 1 of 1</Text>
    </Panel>
    <Text id="quiz-timer" class="quiz-timer">01:00</Text>
  </Panel>

  <Text id="quiz-question" class="quiz-question">
    Which of these values is a Python integer?
  </Text>

  <Panel id="quiz-answer-row-1" class="answer-row">
    <Button id="quiz-answer-0" class="answer-button">A. 3.14</Button>
    <Button id="quiz-answer-1" class="answer-button">B. 42</Button>
  </Panel>

  <Panel id="quiz-answer-row-2" class="answer-row">
    <Button id="quiz-answer-2" class="answer-button">C. True</Button>
    <Button id="quiz-answer-3" class="answer-button">D. Hello</Button>
  </Panel>

  <Text class="quiz-instruction">Select one answer</Text>

  <Panel class="quiz-actions">
    <Button id="quiz-submit" class="submit-button">SUBMIT ANSWER</Button>
    <Button id="quiz-clear" class="clear-button">CLEAR SELECTION</Button>
  </Panel>

  <Text id="quiz-feedback" class="quiz-feedback"></Text>
</Panel>
