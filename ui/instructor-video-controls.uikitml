<style>
  .controls {
    width: 620;
    height: 104;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 22;
    padding: 16;
    background-color: rgba(5, 13, 29, 0.94);
    border-width: 2;
    border-color: rgba(103, 232, 249, 0.72);
    border-radius: 24;
    pointer-events: auto;
  }
  .control-button {
    width: 270;
    height: 70;
    align-items: center;
    justify-content: center;
    border-radius: 16;
    border-width: 2;
    color: #ffffff;
    font-size: 21;
    font-weight: 700;
    font-family: inter;
    cursor: pointer;
    pointer-events: auto;
  }
  .play { background-color: rgba(8, 145, 178, 0.78); border-color: #67e8f9; }
  .play:hover { background-color: rgba(6, 182, 212, 0.92); }
  .return { background-color: rgba(153, 27, 27, 0.82); border-color: #fca5a5; }
  .return:hover { background-color: rgba(220, 38, 38, 0.9); }
</style>

<div class="controls">
  <button id="video-play-pause" class="control-button play">PAUSE VIDEO</button>
  <button id="video-return-class" class="control-button return">BACK TO CLASS</button>
</div>
