<style>
  .quiz-monitor-root {
    width: 940;
    padding: 32;
    flex-direction: column;
    gap: 20;
    background-color: rgba(5, 15, 35, 0.98);
    border-width: 2;
    border-color: rgba(34, 211, 238, 0.72);
    border-radius: 30;
    pointer-events: auto;
    pointer-events-order: 13000;
  }

  .quiz-monitor-header {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 18;
    border-bottom-width: 1;
    border-bottom-color: rgba(148, 163, 184, 0.24);
  }

  .quiz-header-copy {
    width: 800;
    flex-direction: column;
    gap: 8;
  }

  .quiz-monitor-title {
    color: #67e8f9;
    font-size: 22;
    font-weight: bold;
  }

  .quiz-question-title {
    color: white;
    font-size: 31;
    font-weight: bold;
  }

  .quiz-monitor-summary {
    color: #c4b5fd;
    font-size: 17;
  }

  .quiz-monitor-close {
    width: 58;
    height: 58;
    align-items: center;
    justify-content: center;
    background-color: rgba(239, 68, 68, 0.18);
    border-width: 1;
    border-color: rgba(248, 113, 113, 0.65);
    border-radius: 29;
    color: white;
    font-size: 22;
    font-weight: bold;
    cursor: pointer;
    pointer-events: auto;
    pointer-events-order: 13001;
  }

  .quiz-column-header {
    width: 100%;
    flex-direction: row;
    padding-left: 18;
    padding-right: 18;
    color: #94a3b8;
    font-size: 15;
    font-weight: bold;
  }

  .quiz-student-list {
    width: 100%;
    flex-direction: column;
    gap: 11;
  }

  .quiz-student-row {
    width: 100%;
    height: 70;
    flex-direction: row;
    align-items: center;
    padding-left: 18;
    padding-right: 18;
    background-color: rgba(30, 41, 59, 0.82);
    border-width: 1;
    border-color: rgba(148, 163, 184, 0.22);
    border-radius: 14;
  }

  .quiz-row-hidden {
    display: none;
  }

  .quiz-name-cell {
    width: 280;
    color: white;
    font-size: 19;
    font-weight: bold;
  }

  .quiz-answer-cell {
    width: 390;
    color: #bfdbfe;
    font-size: 18;
    font-weight: bold;
  }

  .quiz-result-cell {
    width: 200;
    color: #fcd34d;
    font-size: 18;
    font-weight: bold;
  }

  .quiz-result-correct {
    color: #86efac;
  }

  .quiz-result-wrong {
    color: #fca5a5;
  }

  .quiz-footer {
    color: #94a3b8;
    font-size: 15;
    text-align: center;
  }
</style>

<Panel class="quiz-monitor-root">
  <Panel class="quiz-monitor-header">
    <Panel class="quiz-header-copy">
      <Text class="quiz-monitor-title">QUICK CHALLENGE — LIVE MONITOR</Text>
      <Text id="quiz-monitor-question" class="quiz-question-title">Waiting for question</Text>
      <Text id="quiz-monitor-summary" class="quiz-monitor-summary">0 of 0 students answered</Text>
    </Panel>
    <Button id="quiz-monitor-close" class="quiz-monitor-close">X</Button>
  </Panel>

  <Panel class="quiz-column-header">
    <Text class="quiz-name-cell">STUDENT</Text>
    <Text class="quiz-answer-cell">SELECTED ANSWER</Text>
    <Text class="quiz-result-cell">RESULT</Text>
  </Panel>

  <Panel class="quiz-student-list">
    <Panel id="quiz-monitor-row-1" class="quiz-student-row"><Text id="quiz-monitor-name-1" class="quiz-name-cell">—</Text><Text id="quiz-monitor-answer-1" class="quiz-answer-cell">Waiting for answer</Text><Text id="quiz-monitor-result-1" class="quiz-result-cell">UNANSWERED</Text></Panel>
    <Panel id="quiz-monitor-row-2" class="quiz-student-row"><Text id="quiz-monitor-name-2" class="quiz-name-cell">—</Text><Text id="quiz-monitor-answer-2" class="quiz-answer-cell">Waiting for answer</Text><Text id="quiz-monitor-result-2" class="quiz-result-cell">UNANSWERED</Text></Panel>
    <Panel id="quiz-monitor-row-3" class="quiz-student-row"><Text id="quiz-monitor-name-3" class="quiz-name-cell">—</Text><Text id="quiz-monitor-answer-3" class="quiz-answer-cell">Waiting for answer</Text><Text id="quiz-monitor-result-3" class="quiz-result-cell">UNANSWERED</Text></Panel>
    <Panel id="quiz-monitor-row-4" class="quiz-student-row"><Text id="quiz-monitor-name-4" class="quiz-name-cell">—</Text><Text id="quiz-monitor-answer-4" class="quiz-answer-cell">Waiting for answer</Text><Text id="quiz-monitor-result-4" class="quiz-result-cell">UNANSWERED</Text></Panel>
    <Panel id="quiz-monitor-row-5" class="quiz-student-row"><Text id="quiz-monitor-name-5" class="quiz-name-cell">—</Text><Text id="quiz-monitor-answer-5" class="quiz-answer-cell">Waiting for answer</Text><Text id="quiz-monitor-result-5" class="quiz-result-cell">UNANSWERED</Text></Panel>
    <Panel id="quiz-monitor-row-6" class="quiz-student-row"><Text id="quiz-monitor-name-6" class="quiz-name-cell">—</Text><Text id="quiz-monitor-answer-6" class="quiz-answer-cell">Waiting for answer</Text><Text id="quiz-monitor-result-6" class="quiz-result-cell">UNANSWERED</Text></Panel>
    <Panel id="quiz-monitor-row-7" class="quiz-student-row"><Text id="quiz-monitor-name-7" class="quiz-name-cell">—</Text><Text id="quiz-monitor-answer-7" class="quiz-answer-cell">Waiting for answer</Text><Text id="quiz-monitor-result-7" class="quiz-result-cell">UNANSWERED</Text></Panel>
    <Panel id="quiz-monitor-row-8" class="quiz-student-row"><Text id="quiz-monitor-name-8" class="quiz-name-cell">—</Text><Text id="quiz-monitor-answer-8" class="quiz-answer-cell">Waiting for answer</Text><Text id="quiz-monitor-result-8" class="quiz-result-cell">UNANSWERED</Text></Panel>
    <Panel id="quiz-monitor-row-9" class="quiz-student-row"><Text id="quiz-monitor-name-9" class="quiz-name-cell">—</Text><Text id="quiz-monitor-answer-9" class="quiz-answer-cell">Waiting for answer</Text><Text id="quiz-monitor-result-9" class="quiz-result-cell">UNANSWERED</Text></Panel>
    <Panel id="quiz-monitor-row-10" class="quiz-student-row"><Text id="quiz-monitor-name-10" class="quiz-name-cell">—</Text><Text id="quiz-monitor-answer-10" class="quiz-answer-cell">Waiting for answer</Text><Text id="quiz-monitor-result-10" class="quiz-result-cell">UNANSWERED</Text></Panel>
  </Panel>

  <Text id="quiz-monitor-footer" class="quiz-footer">The list updates as students submit.</Text>
</Panel>
