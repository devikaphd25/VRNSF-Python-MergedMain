          <Button id="quiz-monitor-wrong-answers" class="quiz-wrong-answers-button">VIEW COMMON MISTAKES</Button>
        </Panel>
        <Text id="quiz-monitor-footer" class="quiz-footer">The list updates as students submit.</Text>
      </Panel>
    </Panel>
    <Image id="quiz-monitor-title-banner" class="quiz-monitor-title-banner" src="/textures/challenge1_instructor/Title_for_Dashboard.png" />
  </Panel>

  <Panel id="quiz-monitor-timer-ring" class="quiz-monitor-timer-dock">
    <Image id="quiz-monitor-timer-progress" class="quiz-monitor-timer-progress" src="/textures/challenge1_instructor/Clock_Background.png" />
    <Text id="quiz-monitor-timer" class="quiz-monitor-timer">01:00</Text>
  </Panel>
</Panel>
