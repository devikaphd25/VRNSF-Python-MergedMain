<!-- src/ui/raise-hand-button.uikitml -->

<style>
  .raise-hand-root {
    width: 200;
    height: 220;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
  }

  .raise-hand-circle {
    width: 160;
    height: 160;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0;
    background-color: rgba(37, 99, 235, 0.25);
    border-radius: 80;
    border-width: 3;
    border-color: rgba(96, 165, 250, 0.7);
    cursor: pointer;
    pointer-events: auto;
    transition: all 0.3s ease;
  }

  .raise-hand-circle:hover {
    background-color: rgba(37, 99, 235, 0.4);
    border-color: rgba(96, 165, 250, 1);
    transform: scale(1.02);
  }

  /* ✅ RAISED state */
  .raise-hand-circle.raised {
    background-color: rgba(255, 68, 0, 0.25);
    border-color: rgba(255, 68, 0, 0.7);
    animation: pulse 1.5s infinite;
  }

  .raise-hand-circle.raised:hover {
    background-color: rgba(255, 68, 0, 0.4);
    border-color: rgba(255, 68, 0, 1);
  }

  /* ✅ PULSE animation for feedback */
  .raise-hand-circle.pulse {
    animation: pulseFeedback 0.5s ease 2;
  }

  .raise-hand-model-container {
    width: 120;
    height: 120;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .raise-hand-label {
    color: rgba(255, 255, 255, 0.95);
    font-size: 16;
    font-weight: 600;
    text-align: center;
    font-family: inter;
    margin-top: 10;
    pointer-events: none;
    transition: color 0.3s ease;
  }

  /* ✅ Label changes color when raised */
  .raise-hand-label.raised {
    color: rgba(255, 200, 0, 0.95);
  }

  .raise-hand-status {
    color: rgba(255, 255, 255, 0.4);
    font-size: 11;
    font-weight: 400;
    text-align: center;
    font-family: inter;
    margin-top: 2;
    pointer-events: none;
    transition: color 0.3s ease;
  }

  /* ✅ Status changes when raised */
  .raise-hand-status.raised {
    color: rgba(255, 200, 0, 0.9);
  }

  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }

  /* ✅ Pulse feedback animation */
  @keyframes pulseFeedback {
    0% { transform: scale(1); }
    50% { transform: scale(1.15); }
    100% { transform: scale(1); }
  }
</style>

<div id="raise-hand-root" class="raise-hand-root">
  <button
    id="raise-hand-circle"
    class="raise-hand-circle"
    onclick="window.RaiseHandSystem?.onButtonClick()"
  >
    <div
      id="raise-hand-model-container"
      class="raise-hand-model-container"
    >
      <!-- GLB model will be inserted here -->
    </div>
  </button>

  <text id="raise-hand-label" class="raise-hand-label">Raise Hand</text>
  <text id="raise-hand-status" class="raise-hand-status">Select to raise</text>
</div>