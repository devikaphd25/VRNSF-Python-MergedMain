<style>
  .dashboard-root {
    width: 900;
    flex-direction: column;
    gap: 24;

    padding-top: 34;
    padding-bottom: 34;
    padding-left: 38;
    padding-right: 38;

    background-color: rgba(8, 15, 30, 0.98);

    border-radius: 32;
    border-width: 2;
    border-color: rgba(96, 165, 250, 0.55);

    pointer-events: auto;
    pointer-events-order: 1000;
  }

  /* ======================================================
     HEADER
     ====================================================== */

  .dashboard-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;

    padding-bottom: 22;

    border-bottom-width: 1;
    border-bottom-color: rgba(255, 255, 255, 0.14);

    pointer-events: auto;
  }

  .title-area {
    flex-direction: column;
    gap: 8;
    pointer-events: none;
  }

  .dashboard-title {
    color: #ffffff;
    font-size: 36;
    font-weight: 700;
    font-family: inter;
  }

  .dashboard-subtitle {
    color: #94a3b8;
    font-size: 17;
    font-family: inter;
  }

  .live-badge {
    width: 150;
    padding-top: 6;
    padding-bottom: 6;
    padding-left: 10;
    padding-right: 10;
    background-color: rgba(16, 185, 129, 0.16);
    border-width: 1;
    border-color: rgba(52, 211, 153, 0.55);
    border-radius: 12;
    color: #86efac;
    font-size: 13;
    font-weight: 700;
    text-align: center;
  }

  .close-button {
    width: 58;
    height: 58;

    align-items: center;
    justify-content: center;

    background-color: rgba(255, 255, 255, 0.1);

    border-radius: 29;
    border-width: 1;
    border-color: rgba(255, 255, 255, 0.22);

    color: #ffffff;
    font-size: 22;
    font-weight: 700;

    cursor: pointer;
    pointer-events: auto;
    pointer-events-order: 10001;
  }

  .close-button:hover {
    background-color: rgba(239, 68, 68, 0.35);
    border-color: rgba(248, 113, 113, 0.8);
  }

  /* ======================================================
     SUMMARY CARDS
     ====================================================== */

  .summary-row {
    flex-direction: row;
    gap: 18;

    pointer-events: none;
  }

  .summary-card {
    flex-grow: 1;
    height: 150;

    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8;

    background-color: rgba(30, 41, 59, 0.8);

    border-radius: 22;
    border-width: 1;
    border-color: rgba(148, 163, 184, 0.25);
  }

  .online-card {
    background-color: rgba(22, 101, 52, 0.28);
    border-color: rgba(74, 222, 128, 0.5);
  }

  .mode-card {
    background-color: rgba(30, 64, 175, 0.25);
    border-color: rgba(96, 165, 250, 0.5);
  }

  .summary-number {
    color: #86efac;
    font-size: 52;
    font-weight: 700;
    font-family: inter;
  }

  .summary-label {
    color: #d1fae5;
    font-size: 17;
    font-weight: 600;
    font-family: inter;
  }

  .summary-small-label {
    color: #93c5fd;
    font-size: 15;
    font-weight: 600;
    font-family: inter;
  }

  .current-mode {
    color: #ffffff;
    font-size: 25;
    font-weight: 700;
    font-family: inter;
    text-align: center;
  }

  /* ======================================================
     ACTIVITY SECTION
     ====================================================== */

  .activity-section {
    flex-direction: column;
    gap: 16;
    pointer-events: auto;
    pointer-events-order: 1000;
  }

  .section-title {
    color: #e2e8f0;
    font-size: 22;
    font-weight: 700;
    font-family: inter;
    pointer-events: none;
  }

  .mode-grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 16;
    pointer-events: auto;
    pointer-events-order: 1000;
  }

  .mode-button {
    width: 395;
    height: 150;

    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 10;

    padding-left: 24;
    padding-right: 24;
    padding-top: 20;
    padding-bottom: 20;

    background-color: rgba(30, 41, 59, 0.9);

    border-radius: 22;
    border-width: 2;
    border-color: rgba(148, 163, 184, 0.25);

    cursor: pointer;
    pointer-events: auto;
    pointer-events-order: 10001;
  }

  .mode-button:hover {
    background-color: rgba(51, 65, 85, 1);
    border-color: rgba(96, 165, 250, 0.75);
  }

  .mode-button-active {
    background-color: rgba(37, 99, 235, 0.35);
    border-color: rgba(96, 165, 250, 1);
  }

  .class-button {
    background-color: rgba(30, 64, 175, 0.24);
  }

  .presentation-button {
    background-color: rgba(109, 40, 217, 0.23);
  }

  .lab-button {
    background-color: rgba(5, 150, 105, 0.22);
  }

  .challenge-button {
    background-color: rgba(217, 119, 6, 0.22);
  }

  .button-icon {
    color: #ffffff;
    font-size: 31;
    font-weight: 700;
    pointer-events: none;
    font-family: inter;
  }

  .button-title {
    color: #ffffff;
    font-size: 22;
    font-weight: 700;
    pointer-events: none;
    font-family: inter;
  }

  .button-description {
    color: #cbd5e1;
    font-size: 14;
    font-family: inter;
    pointer-events: none;
  }

  /* ======================================================
     STATUS
     ====================================================== */

  .status-area {
    align-items: center;
    justify-content: center;

    padding-top: 15;
    padding-bottom: 15;
    padding-left: 18;
    padding-right: 18;

    background-color: rgba(15, 23, 42, 0.9);

    border-radius: 14;
    border-width: 1;
    border-color: rgba(148, 163, 184, 0.2);

    pointer-events: none;
  }


  .status-text {
    color: #94a3b8;
    font-size: 15;
    font-family: inter;
  }
</style>

<Panel
  id="instructor-dashboard-root"
  class="dashboard-root"
>
  <div class="dashboard-header">
    <div class="title-area">
      <span class="dashboard-title">
        Instructor Command Center
      </span>

      <span class="dashboard-subtitle">
        Orchestrate the live immersive classroom
      </span>

      <span class="live-badge">
        UMES VR  •  LIVE
      </span>
    </div>

    <button
      id="dashboard-close-button"
      class="close-button"
    >
      X
    </button>
  </div>

  <div class="summary-row">
    <div class="summary-card online-card">
      <span
        id="online-student-count"
        class="summary-number"
      >
        0
      </span>

      <span
        id="online-student-label"
        class="summary-label"
      >
        Students Online
      </span>
    </div>

    <div class="summary-card mode-card">
      <span class="summary-small-label">
        Current Activity
      </span>

      <span
        id="current-mode-text"
        class="current-mode"
      >
        Classroom Mode
      </span>
    </div>
  </div>

  <div class="activity-section">
    <span class="section-title">
      Choose Classroom Activity
    </span>

    <div class="mode-grid">
      <button
        id="class-mode-button"
        class="mode-button class-button mode-button-active"
      >
        <span class="button-icon">
          CLASS
        </span>

        <span class="button-title">
          Classroom Mode
        </span>

        <span class="button-description">
          Return all students to their assigned seats
        </span>
      </button>

      <button
        id="presentation-mode-button"
        class="mode-button presentation-button"
      >
        <span class="button-icon">
          PRESENT
        </span>

        <span class="button-title">
          Presentation
        </span>

        <span class="button-description">
          Focus all students on the projector screen
        </span>
      </button>

      <button
        id="lab-mode-button"
        class="mode-button lab-button"
      >
        <span class="button-icon">
          LAB
        </span>

        <span class="button-title">
          Individual Lab
        </span>

        <span class="button-description">
          Send students to the Python learning activity
        </span>
      </button>

      <button
        id="quick-challenge-button"
        class="mode-button challenge-button"
      >
        <span class="button-icon">
          QUIZ
        </span>

        <span class="button-title">
          Quick Challenge
        </span>

        <span class="button-description">
          Start a short classroom knowledge challenge
        </span>
      </button>
    </div>
  </div>

  <div class="status-area">
    <span
      id="dashboard-status-text"
      class="status-text"
    >
      Select a classroom activity
    </span>
  </div>
</Panel>
