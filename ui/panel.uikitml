<style>
  .panel-root {
    padding: 28px;
    flex-direction: column;
    align-items: center;
    width: 480px;
    background-color: #1c1c1e;
    border-radius: 20px;
  }

  .title {
    font-size: 24px;
    font-weight: 700;
    color: white;
    margin-bottom: 6px;
  }

  .subtitle {
    color: #9a9a9e;
    font-size: 14px;
    margin-bottom: 20px;
  }

  .subtitle-error { color: #ff6b6b; }
  .subtitle-success { color: #4ade80; }

  .role-toggle {
    flex-direction: row;
    width: 100%;
    background-color: #2c2c2e;
    border-radius: 999px;
    padding: 4px;
    gap: 4px;
    margin-bottom: 24px;
  }

  .role-segment {
    flex-direction: row;
    width: 210px;
    height: 40px;
    justify-content: center;
    align-items: center;
    border-radius: 999px;
    gap: 6px;
    background-color: #5f5d5d;
    color: #9a9a9e;
    font-size: 14px;
    text-align: center;
    vertical-align: center;
  }

  .role-icon {
    width: 15px;
    height: 15px;
    color: #9a9a9e;
  }

  .role-segment:hover {
    background-color: #3a3a3c;
  }

  .role-segment-selected {
    background-color: #ffffff;
    color: #1c1c1e;
  }

  .role-segment-selected .role-icon {
    color: #1c1c1e;
  }

  .pin-row {
    flex-direction: row;
    justify-content: center;
    gap: 10px;
    width: 100%;
    margin-bottom: 24px;
  }

  .pin-slot {
    width: 44px;
    height: 54px;
    justify-content: center;
    align-items: center;
    border-radius: 10px;
    background-color: #2c2c2e;
    border-width: 2px;
    border-color: #3a3a3c;
  }

  .pin-slot-filled {
    border-color: #ffffff;
    background-color: #333335;
  }

  .pin-digit {
    width: 100%;
    height: 100%;
    text-align: center;
    vertical-align: center;
    color: white;
    font-size: 22px;
    font-weight: 600;
  }

  .keypad {
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
    margin-bottom: 22px;
  }

  .keypad-row {
    flex-direction: row;
    gap: 10px;
  }

  .keypad-key {
    width: 60px;
    height: 54px;
    justify-content: center;
    align-items: center;
    border-radius: 10px;
  }

  .key-btn {
    background-color: #2c2c2e;
    color: white;
    font-size: 19px;
    text-align: center;
    vertical-align: center;
  }

  .key-btn:hover {
    background-color: #3a3a3c;
  }

  .key-pressed {
    border-width: 2px;
    border-color: #22c55e;
  }

  .key-spacer {
    width: 75px;
    height: 54px;
  }

  .backspace-btn {
    background-color: #2c2c2e;
    color: #ff6b6b;
  }

  .backspace-icon {
    width: 20px;
    height: 20px;
    color: #ff6b6b;
  }

  .backspace-btn:hover {
    background-color: #3a3a3c;
  }

  .backspace-btn:active {
    background-color: #4a4a4c;
  }

  .backspace-pressed {
    border-width: 2px;
    border-color: #22c55e;
  }

  .btn-base {
    width: 100%;
    height: 48px;
    justify-content: center;
    align-items: center;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    text-align: center;
    vertical-align: center;
  }

  .btn-continue {
    background-color: #ffffff;
    color: #1c1c1e;
  }

  .btn-continue:hover {
    background-color: #e4e4e6;
  }

  .btn-continue-busy {
    background-color: #5a5a5c;
    color: #b0b0b2;
  }

  /* Students never type a code, so the keypad, pin row and confirm button are
     hidden for that role — the panel just waits for a class to go live. */
  .is-hidden {
    display: none;
  }
</style>

<Panel id="panel-root" class="panel-root">
  <text id="title-text" class="title">Create Classroom</text>
  <text id="subtitle-text" class="subtitle">Enter the professor PIN</text>

  <div id="role-toggle" class="role-toggle">
    <button id="role-professor" class="role-segment role-segment-selected">
      <GraduationCapIcon class="role-icon"></GraduationCapIcon>
      Professor
    </button>
    <button id="role-student" class="role-segment">
      <UserIcon class="role-icon"></UserIcon>
      Student
    </button>
  </div>

  <div id="pin-row" class="pin-row">
    <div id="pin-slot-0" class="pin-slot"><text id="pin-digit-0" class="pin-digit">0</text></div>
    <div id="pin-slot-1" class="pin-slot"><text id="pin-digit-1" class="pin-digit">0</text></div>
    <div id="pin-slot-2" class="pin-slot"><text id="pin-digit-2" class="pin-digit">0</text></div>
    <div id="pin-slot-3" class="pin-slot"><text id="pin-digit-3" class="pin-digit">0</text></div>
    <div id="pin-slot-4" class="pin-slot"><text id="pin-digit-4" class="pin-digit">0</text></div>
    <div id="pin-slot-5" class="pin-slot"><text id="pin-digit-5" class="pin-digit">0</text></div>
  </div>

  <div id="keypad" class="keypad">
    <div class="keypad-row">
      <button id="key-1" class="key-btn keypad-key">1</button>
      <button id="key-2" class="key-btn keypad-key">2</button>
      <button id="key-3" class="key-btn keypad-key">3</button>
    </div>
    <div class="keypad-row">
      <button id="key-4" class="key-btn keypad-key">4</button>
      <button id="key-5" class="key-btn keypad-key">5</button>
      <button id="key-6" class="key-btn keypad-key">6</button>
    </div>
    <div class="keypad-row">
      <button id="key-7" class="key-btn keypad-key">7</button>
      <button id="key-8" class="key-btn keypad-key">8</button>
      <button id="key-9" class="key-btn keypad-key">9</button>
    </div>
    <div class="keypad-row">
      <div class="key-spacer"></div>
      <button id="key-0" class="key-btn keypad-key">0</button>
      <button id="key-backspace" class="backspace-btn keypad-key">
        <DeleteIcon class="backspace-icon"></DeleteIcon>
      </button>
    </div>
  </div>

  <button id="confirm-btn" class="btn-base btn-continue">Create Classroom</button>
</Panel>
