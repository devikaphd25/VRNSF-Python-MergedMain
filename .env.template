# Copy to .env.server only on first setup; fill in private server credentials.
# Project URL: project Connect dialog / API settings, without /rest/v1.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server secret key from Settings > API Keys (sb_secret_...). Never commit it.
# An enabled legacy service_role key also works here; publishable/anon does not.
SUPABASE_SECRET_KEY=[REDACTED_SUPABASE_SECRET]
WEEK_NUMBER=1
# Normal Vite development proxies /api and /socket.io to this port.
PORT=3001
